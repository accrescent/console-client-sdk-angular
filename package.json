{
    "name": "@accrescent/console-client-sdk-angular",
    "version": "0.11.0",
    "description": "Angular client SDK for the Accrescent console API",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/accrescent/console-client-sdk-angular.git"
    },
    "type": "module",
    "scripts": {
        "build": "buf generate && node scripts/generatePackaging.ts && ng-packagr",
        "clean": "node scripts/cleanPackaging.ts",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:ci": "oxlint --deny-warnings --format=github",
        "lint:fix": "oxlint --fix"
    },
    "devDependencies": {
        "@accrescent/protoc-gen-grpc-angular": "^0.4.1",
        "@bufbuild/buf": "^1.66.1",
        "@bufbuild/protoc-gen-es": "^2.11.0",
        "@types/node": "^25.5.0",
        "ng-packagr": "^21.2.1",
        "oxfmt": "^0.41.0",
        "oxlint": "^1.56.0"
    },
    "peerDependencies": {
        "@angular/common": "^21.0.0",
        "@angular/core": "^21.0.0",
        "@bufbuild/protobuf": "^2.11.0",
        "rxjs": "^6.5.3 || ^7.4.0"
    }
}
